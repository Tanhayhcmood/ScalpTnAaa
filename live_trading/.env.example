# GoldScalperPro v4 — Live Trading Engine Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# For Render deployment, set these in the Render dashboard → Environment tab.

# ══════════════════════════════════════════════════════════════════════════════
# REQUIRED — Direct MTAPI Credentials
# ══════════════════════════════════════════════════════════════════════════════

# Official MTAPI REST endpoint. No UserKey or API key is required.
MTAPI_URL=https://mt5.mtapi.io
MT5_HOST=52.18.32.194
MT5_PORT=443
MT5_USER=
MT5_PASSWORD=

# ══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Trading Parameters (defaults shown)
# ══════════════════════════════════════════════════════════════════════════════

# Instrument to trade (use broker-specific symbol suffix if needed)
# AMarkets reports gold as XAUUSD (no suffix)
SYMBOL=XAUUSD

# Primary trading timeframe, and the multi-timeframe scan order (highest first).
TIMEFRAME=5m
TRADE_TIMEFRAMES=1m
# Protective-stop ATR source; keep it above the signal timeframe.
SL_ATR_TIMEFRAME=M5
SL_ATR_PERIOD=14

# Maximum age of a BOS/CHoCH event for a new entry (closed bars)
STRUCTURE_MAX_AGE_BARS=24

# Risk per trade as % of account balance
RISK_PERCENT=1.0

# Minimum signal confirmations required for ordinary entries. Trend-aligned
# entries have the separate TREND_MIN_CONFIRMATIONS floor below.
MIN_CONFIRMATIONS=2
# A Trend-aligned ordinary entry needs at least two independent votes.
TREND_MIN_CONFIRMATIONS=2
# Base protective SL distance is 3.0x higher-timeframe ATR, capped at 3.5x.
SL_ATR_BASE_MULTIPLIER=3.0
# Extra protective distance during LOW_VOLATILITY (capped at 3.5x total).
LOW_VOLATILITY_SL_ATR_ADD=0.5
# Only these engines can authorize live entries. SMC and Wyckoff remain
# available for diagnostics/telemetry but cannot open trades.
ENABLED_STRATEGIES=trend,price_action

# ── Dedicated RANGE playbook ────────────────────────────────────────────────
# By default, RANGE entries require a range edge, a fresh same-direction
# liquidity sweep, a closed-candle reversal, and at least
# RANGE_MIN_CONFIRMATIONS aligned strategy votes.
RANGE_TRADING_ENABLED=true
RANGE_MIN_CONFIRMATIONS=2
RANGE_MIN_RR=1.5
RANGE_EDGE_ATR_DISTANCE=0.25
# Half of the normal 1% risk by default.
RANGE_RISK_PERCENT=0.5
# Set false to disable only the Option 2-specific RANGE entry blockers.
# RANGE context remains available for telemetry and capital sizing.
RANGE_ENTRY_FILTERS_ENABLED=true
MAX_RANGE_TRADES_PER_SESSION=2
MAX_OPEN_TRADES=4
# Keep the symbol directional: block BUY while SELL is open, and vice versa.
ALLOW_HEDGED_POSITIONS=false
# Allow a directional Price Action signal to authorize an entry alone.
PRICE_ACTION_STANDALONE=false
PA_STANDALONE_MIN_SCORE=0.24
PA_MAX_BREAKOUT_EXTENSION_ATR=0.75
# Require a same-direction Price Action signal before any trade is allowed.
REQUIRE_PRICE_ACTION=false

# ── Higher-timeframe negative-only opposition filter ─────────────────────────
# The filter only rejects an entry when HTF trend opposition is strong.
MTF_ENABLED=true
MTF_TIMEFRAME=H1
MTF_CANDLE_WINDOW=300
# Trend Engine score (0..100) required to classify opposition as strong.
MTF_OPPOSITION_THRESHOLD=55
# Observe decisions for several hours before enabling hard rejects.
MTF_DRY_RUN=false

# Confidence-engine hard floor and quality-filter ADX floor.
NORMAL_MIN_CONFIDENCE=40
RANGE_MIN_CONFIDENCE=40
CONF_HARD_MIN=40
QUALITY_ADX_MIN=10

# Restore broker history after a Render restart and keep it refreshed.
HISTORY_LOOKBACK_DAYS=90
HISTORY_SYNC_INTERVAL=300

# ══════════════════════════════════════════════════════════════════════════════
# STRONGLY RECOMMENDED — Risk Guardian Circuit Breakers
# Review these values carefully. They are active even at their defaults.
# ══════════════════════════════════════════════════════════════════════════════

# Halt trading if intraday PnL falls below this % of session-open balance.
# Resets automatically at UTC midnight.
DAILY_LOSS_LIMIT_PCT=3.0

# Halt trading if live equity drops more than this % below the session equity peak.
# Does NOT auto-reset — requires /reset_guardian in the Telegram panel.
MAX_DRAWDOWN_PCT=8.0

# Maximum allowed slippage for market orders (in broker points).
# 30 points ≈ $0.30 on XAUUSD with a standard 5-digit broker.
# Increase to 50 during high-volatility periods (news events).
SLIPPAGE_POINTS=30

# ══════════════════════════════════════════════════════════════════════════════
# ADAPTIVE ATR TRAILING STOP
# ══════════════════════════════════════════════════════════════════════════════
# After 1R and breakeven, Chandelier distance is ATR(period) multiplied by
# this tunable factor. Valid range is 2.0–3.0.
TRAIL_ENABLED=true
TRAIL_ATR_PERIOD=14
TRAIL_CHANDELIER_ATR_MULTIPLIER=2.5
TRAIL_NORMAL_MULTIPLIER=2.0
TRAIL_TIGHT_MULTIPLIER=0.9
# Legacy exhaustion telemetry setting; it no longer authorizes an SL move.
TRAIL_EXHAUSTION_CONFIRM_COUNT=2
TRAIL_MOMENTUM_LOOKBACK=3
TRAIL_BODY_SHRINK_RATIO=0.8
TRAIL_VOLUME_SHRINK_RATIO=0.8
TRAIL_MIN_PROFIT_ATR=1.5
TRAIL_MIN_DISTANCE_ATR=1.0
TRAIL_MIN_STEP_PRICE=0.05

# RANGE + WEAK uses the same two-engine Trend + Price Action floor.
RANGE_WEAK_MIN_CONFIRMATIONS=2

# Hard limit for each broker data-plane request so a stalled HTTP call cannot
# freeze the engine heartbeat.
RPC_CALL_TIMEOUT=30

# ══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — File Paths
# On Render free tier, /tmp is the only writable directory.
# Override these if you have a mounted persistent disk (e.g. /data).
# ══════════════════════════════════════════════════════════════════════════════

STATE_FILE=/tmp/robot_state.json
MT5_SNAPSHOT=/tmp/robot_mt5_snapshot.json
COMMANDS_FILE=/tmp/robot_commands.json
GUARDIAN_STATE_FILE=/tmp/guardian_state.json
LOG_FILE=/tmp/robot.log

# Shared secret required by the panel-to-robot HTTP command fallback.
# Use a long random value and set the same value in the Telegram panel.
ROBOT_COMMAND_TOKEN=

# ══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Redis for cross-service IPC
# ══════════════════════════════════════════════════════════════════════════════
# When robot and panel run as separate Render services they have separate
# filesystems and CANNOT share JSON files. Redis bridges this gap.
# On Render: set automatically via `fromService` in render.yaml.
# Locally: leave empty to use file-based IPC (both services on same machine).
#
# REDIS_URL=redis://localhost:6379
